{
  "name": "react-native-turbo-image",
  "version": "2.0.0-alpha.0",
  "description": "Performant image component for React Native (New Architecture only)",
  "license": "MIT",
  "author": "duguyihou <duguyihou@gmail.com> (https://github.com/duguyihou)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duguyihou/react-native-turbo-image.git",
    "directory": "v2/packages/react-native-turbo-image"
  },
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "cpp/include",
    "cpp/src",
    "cpp/CMakeLists.txt",
    "ios",
    "android",
    "!android/build",
    "!android/.cxx",
    "Package.swift",
    "TurboImage.podspec",
    "!**/__tests__",
    "!ios/Tests"
  ],
  "main": "src/index.tsx",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/index.d.ts",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "prepack": "bun run build:types && bash ../../scripts/check-pack.sh",
    "test": "jest",
    "test:core": "cmake -S cpp -B build/core -DTURBOIMAGE_BUILD_TESTS=ON -DTURBOIMAGE_WARNINGS_AS_ERRORS=ON && cmake --build build/core -j && ctest --test-dir build/core --output-on-failure",
    "test:ios": "bash ../../scripts/test-ios-adapter.sh",
    "vendor:nuke": "bash ../../scripts/build-nuke-xcframework.sh",
    "goldens:placeholder": "node cpp/tests/tools/generate-placeholder-goldens.mjs > cpp/tests/PlaceholderGoldens.inc"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@jest/globals": "29.7.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "blurhash": "2.0.5",
    "jest": "29.7.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "19.3.0",
    "thumbhash": "0.1.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "TurboImageSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.turboimage"
    },
    "ios": {
      "componentProvider": {
        "TurboImageView": "TurboImageComponentView"
      },
      "modulesProvider": {
        "TurboImageModule": "TurboImageModule"
      }
    }
  },
  "swiftpmConfig": {
    "name": "TurboImage"
  }
}
