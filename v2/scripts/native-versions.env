# Single source of truth for pinned native dependency versions (RFC rule 7).
#
# Shell-sourceable on purpose: build-nuke-xcframework.sh sources it, CI
# exports it, and scripts/check-native-versions.sh asserts that
# Package.swift, TurboImage.podspec and android/build.gradle agree with it.
# Change a version here first, then update the manifests in the same commit.

NUKE_VERSION=13.2.3
COIL_VERSION=3.6.3
KOTLIN_VERSION=2.4.21
GOOGLETEST_VERSION=1.17.0
REACT_NATIVE_VERSION=0.88.1
ANDROID_NDK_VERSION=27.1.12297006
