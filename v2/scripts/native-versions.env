# Pinned native dependency versions (RFC rule 7). Shell-sourceable; scripts
# and CI read it, and check-native-versions.sh checks the manifests match.
# Bump here and in the manifests in the same commit.

NUKE_VERSION=14.0.0
COIL_VERSION=3.6.3
# LINE apng-drawable (Android APNG; ImageDecoder cannot animate APNG).
APNG_DRAWABLE_VERSION=1.12.0
KOTLIN_VERSION=2.4.21
GOOGLETEST_VERSION=1.17.0
REACT_NATIVE_VERSION=0.88.1
# Oldest supported RN (major.minor), enforced by the podspec and
# build.gradle; the npm peer range can't, as it must accept RN-tvos prereleases.
MIN_REACT_NATIVE_VERSION=0.88
ANDROID_NDK_VERSION=27.1.12297006
# Test-only (android/src/androidTest).
ANDROIDX_TEST_VERSION=1.7.0
ANDROIDX_TEST_JUNIT_VERSION=1.3.0
JUNIT_VERSION=4.13.2
