{
  "name": "turbo-image-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "pods": "cd ios && pod install",
    "build:android": "cd android && ./gradlew assembleDebug --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:android:release": "cd android && ./gradlew assembleRelease --console=plain -PreactNativeArchitectures=arm64-v8a",
    "codegen:ios": "node ../../node_modules/react-native/scripts/generate-codegen-artifacts.js -p . -o ios -t ios",
    "build:ios": "bun run codegen:ios && xcodebuild -workspace ios/TurboImageExample.xcworkspace -scheme TurboImageExample -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build build",
    "build:ios:release": "bun run codegen:ios && xcodebuild -workspace ios/TurboImageExample.xcworkspace -scheme TurboImageExample -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build build",
    "smoke:android": "bash ../../scripts/smoke-android.sh",
    "smoke:ios": "bash ../../scripts/smoke-ios.sh"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-turbo-image": "workspace:*",
    "react-native-safe-area-context": "5.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
